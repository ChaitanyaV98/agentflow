# Chat model. "groq" uses the free Groq API (https://console.groq.com/keys);
# "ollama" runs a local model instead (ollama pull qwen2.5:3b).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Optional for reading public repos (raises the limit from 60 to 5,000 requests/hour).
# Required to post comments. Fine-grained token with "Issues: read and write".
GITHUB_TOKEN=

# Web search (free tier, 1,000 searches/month): https://app.tavily.com
# Without it, web_search reports it's unavailable and the agent falls back to fetch_url.
TAVILY_API_KEY=

# Email. Leave SMTP_HOST empty to use a free Ethereal test inbox: nothing is delivered,
# and send_email returns a preview link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Postgres (docker-compose.yml). The app/worker connects as the owner.
DATABASE_URL=postgres://agentflow:agentflow@localhost:5435/agentflow
# The agent's SQL tool connects as a SELECT-only, read-only role limited to the sample `shop` schema.
POSTGRES_READONLY_URL=postgres://agentflow_reader:agentflow_reader@localhost:5435/agentflow

# Optional: list price per 1M tokens for the cost budget (defaults: Groq gpt-oss-120b list price).
# PRICE_INPUT_PER_M=0.15
# PRICE_OUTPUT_PER_M=0.6
